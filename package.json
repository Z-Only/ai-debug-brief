{
  "name": "ai-debug-brief",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:static": "python3 scripts/check_static.py",
    "test:gate": "python3 -m unittest discover -s scripts -p 'test_*.py'",
    "ci-gate": "bash scripts/ci_gate.sh"
  },
  "dependencies": {
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.3",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "20.14.5",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.11"
  },
  "description": "A local-first debugging brief builder for build and container logs.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.4.2"
  }
}
